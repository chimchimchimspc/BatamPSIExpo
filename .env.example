# =============================================
# Docker Compose — Environment Variables
# Copy to .env and sesuaikan nilainya
# =============================================

# PostgreSQL
PGPASSWORD=postgres

# JWT (min 32 karakter, ganti sebelum production!)
JWT_SECRET=ganti_ini_dengan_secret_panjang_min_32_karakter

# Next.js Frontend → URL backend yang bisa diakses browser
# Jika diakses dari LAN, ganti localhost dengan IP mesin host
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# CORS — origins yang diizinkan oleh backend
CORS_ORIGINS=http://localhost:3000

# Node environment (development / production)
NODE_ENV=production

# Opsional — Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@jogjafreelance.id

# Opsional — AWS S3 untuk foto profil
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-southeast-1
